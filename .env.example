# ============================================================
#  Atlas settings. Copy to .env and fill in:  cp .env.example .env
#  Never commit .env (it is in .gitignore).
# ============================================================

# --- Login password (required) --------------------------------
# Generate:  python scripts/hash_password.py
#   (or with Docker: docker compose run --rm atlas python scripts/hash_password.py)
# Paste the whole line it prints, including the single quotes.
PASSWORD_HASH=

# --- Language model ------------------------------------------
# anthropic = Claude API; fake = demo mode without a model (for testing)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model id. Default: claude-sonnet-5-5 (chat and site monitoring).
# Stronger and ~2x pricier: claude-opus-5-5
LLM_MODEL=claude-sonnet-5-5
# Thinking depth / cost: low | medium | high | xhigh | max  (low is right for a chat assistant)
LLM_EFFORT=low
# Retry automatically on a fallback model if the main one declines a request
LLM_REFUSAL_FALLBACK=true

# --- Assistant -----------------------------------------------
TIMEZONE=Europe/Moscow
ASSISTANT_NAME=Атлас

# --- Network -------------------------------------------------
# Without Docker the app listens here. Keep 127.0.0.1 unless you know why.
HOST=127.0.0.1
PORT=8000
# Docker: which host interface/port to publish (default 127.0.0.1:8000)
# ATLAS_BIND=127.0.0.1
# ATLAS_PORT=8000
# Set to true once the site is served over HTTPS (reverse proxy)
COOKIE_SECURE=false
# Session lifetime in hours (30 days)
SESSION_TTL_HOURS=720

# --- Spending limit -------------------------------------------
# Hard monthly cap for Claude API spend, USD (0 = no cap). At the limit the model
# is switched off until next month; Telegram, alerts and reminders keep working.
LLM_MONTHLY_BUDGET_USD=10

# --- Second login factor (optional, recommended) -------------
# Generate: python scripts/totp_setup.py   (empty = password only)
TOTP_SECRET=

# --- Telegram (bot from @BotFather) --------------------------
# Never paste the token into chats; keep it only here.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (e.g. from @userinfobot). Others are ignored silently.
TELEGRAM_ALLOWED_CHAT_IDS=
# Atlas address in Tailscale (from `tailscale serve`), e.g. https://s1824923.tailXXXX.ts.net/
# When set, the bot gets an "Атлас" button that opens the app inside Telegram
# (sign-in by your Telegram account; Tailscale must be on on that device).
TELEGRAM_MINIAPP_URL=
# Optional second bot for NEW SITE LEADS only (send-only, no commands).
# Each recipient must open this bot and press Start once. Empty = leads go to the main bot.
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_IDS=

# --- Content calendar and finances ----------------------------
# Morning message "today in the content plan" and payment reminders (HH:MM, empty = off)
CONTENT_REMINDER_TIME=10:00
FINANCE_REMINDER_TIME=10:05
# Reminder N minutes before a post's publish time (0 = off) and an evening
# check "tomorrow's ideas are not filmed yet" (HH:MM, empty = off)
CONTENT_PUBLISH_REMIND_MINUTES=30
CONTENT_EVENING_TIME=20:00

# --- Content-plan-only access (e.g. for a partner) -------------
# Her Telegram chat id: the bot sends her only content-plan reminders and a
# button that opens only the calendar. She cannot talk to the assistant.
CONTENT_TELEGRAM_CHAT_IDS=
# Optional web password for the same access:
#   docker compose run --rm atlas python scripts/hash_password.py content
CONTENT_PASSWORD_HASH=

# --- Site on-call duty (empty SITE_BASE_URL = off) -----------
SITE_BASE_URL=https://forbsa.ru
# Same secret as LEADS feed key on the site
SITE_FEED_KEY=
# Secret path of the server status JSON, e.g. /_status/<random>.json
SITE_STATUS_PATH=
ADMIN_URL=https://forbsa.ru/cp-7k2f9x
SITE_APP_DIR=/opt/forbsa-site
SITE_IP=89.253.237.47
# true after the site launch: alarm if the stub page / noindex comes back
SITE_LAUNCHED=false
# Domain payment date MM-DD: yearly reminder 30 days before (empty = no reminder)
DOMAIN_RENEWAL_DATE=
# Daily "I'm alive" ping URL from an external service (e.g. Better Stack heartbeat)
HEARTBEAT_URL=
# Small, cheap path for alert explanations
MONITOR_LLM_MAX_TOKENS=1200
MONITOR_LLM_DAILY_MAX=10

# --- Logging -------------------------------------------------
LOG_LEVEL=INFO
# true = also log message texts and tool arguments (debugging only!)
LOG_VERBOSE=false
